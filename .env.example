# ===========================
# 应用配置
# ===========================
APP_NAME=ThinkPython
APP_VERSION=1.0.0
APP_DEBUG=True
TIMEZONE=Asia/Shanghai
LANGUAGE=zh-CN

# ===========================
# 模块模式配置
# ===========================
# single: 单模块模式 (所有代码在 app/single 目录)
# multi: 多模块模式 (代码按模块分布在 app/admin, app/api 等目录)
MODULE_MODE=single

# 启用的模块列表 (仅在 MODULE_MODE=multi 时生效)
ENABLED_MODULES=admin,api

# 默认模块 (访问时不指定模块前缀时使用的模块)
DEFAULT_MODULE=api

# 路由前缀
ROUTE_PREFIX=

# ===========================
# CORS 配置
# ===========================
CORS_ORIGINS=*

# ===========================
# 日志配置
# ===========================
LOG_LEVEL=INFO

# ===========================
# 数据库配置
# ===========================
DB_ENABLED=True

# 数据库类型: mysql, postgresql, sqlite, mssql
DB_TYPE=mysql

# MySQL/PostgreSQL/MSSQL 配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thinkpython
DB_USER=root
DB_PASSWORD=

# SQLite 配置 (当 DB_TYPE=sqlite 时使用)
DB_SQLITE_PATH=./data/database.db

# 连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# 是否打印SQL语句 (开发环境可开启)
DB_ECHO=False

# ===========================
# 缓存配置
# ===========================
CACHE_ENABLED=True

# 缓存类型: redis, memory, memcached
CACHE_TYPE=memory

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# Memcached 配置
MEMCACHED_SERVERS=127.0.0.1:11211

# 内存缓存配置
MEMORY_CACHE_MAX_SIZE=1000
MEMORY_CACHE_TTL=300

# 默认过期时间 (秒)
CACHE_DEFAULT_TTL=3600

# 缓存前缀
CACHE_PREFIX=thinkpython:
