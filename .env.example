# ========================================
# ThinkPython 环境配置文件
# ========================================
# 使用说明：
#   1. 本文件包含所有可配置的环境变量，每项都附有详细说明
#   2. 复制本文件为 .env.local 或直接在 .env 中修改
#   3. 生产环境建议通过系统环境变量注入，而非使用 .env 文件
#   4. 修改配置后需要重启服务才能生效
# ========================================


# ========================================
# 应用基础配置
# ========================================

# 应用名称，会显示在 API 文档和健康检查接口中
APP_NAME=ThinkPython

# 应用版本号，建议遵循语义化版本规范 (主版本.次版本.修订号)
APP_VERSION=1.0.0

# 调试模式开关
# True  - 开发环境，启用详细错误信息、自动重载、API 文档页面
# False - 生产环境，隐藏敏感错误信息，提升性能
APP_DEBUG=True

# 应用时区，使用 IANA 时区标识符
# 常用值: Asia/Shanghai, America/New_York, Europe/London, UTC
TIMEZONE=Asia/Shanghai

# 应用默认语言，用于国际化响应消息
# 常用值: zh-CN (简体中文), en-US (英文), ja-JP (日文)
LANGUAGE=zh-CN


# ========================================
# 模块模式配置
# ========================================
# ThinkPython 支持两种项目组织模式：
# 单模块模式 - 所有代码放在 app/single/ 目录，适合小型项目和快速开发
# 多模块模式 - 代码按业务模块拆分（如 admin、api、order），适合中大型项目和团队协作

# 模块模式选择
# single - 单模块模式（默认推荐，新手友好）
# multi  - 多模块模式（适合项目规模扩大后切换）
MODULE_MODE=single

# 启用的模块列表（仅在 MODULE_MODE=multi 时生效）
# 自动发现模式（推荐）：设为 * 或留空，框架自动扫描 app/ 下所有模块，新增模块无需修改配置
# 白名单模式：指定具体模块名（逗号分隔），如 admin,api，只加载配置的模块
# 开发环境建议使用 *，生产环境建议指定具体模块名以便精确控制
ENABLED_MODULES=*

# 默认模块（仅在 MODULE_MODE=multi 时生效）
# 当访问路径不带模块前缀时，使用此模块处理请求
DEFAULT_MODULE=api

# 全局路由前缀（可选）
# 设置后所有接口都会加上此前缀，如设置为 /v1 则访问 /v1/user/list
# 留空表示不添加全局前缀
ROUTE_PREFIX=


# ========================================
# 跨域配置 (CORS)
# ========================================
# 跨域资源共享设置，用于允许前端域名访问 API
# 开发环境可设为 *，生产环境建议指定具体域名

# 允许跨域请求的来源域名，多个用逗号分隔
# *         - 允许所有域名（仅开发环境）
# http://localhost:3000 - 允许本地前端
# https://example.com   - 允许线上前端
CORS_ORIGINS=*


# ========================================
# 日志配置
# ========================================

# 日志记录级别，控制输出日志的详细程度
# DEBUG   - 最详细，包含所有调试信息（开发环境推荐）
# INFO    - 一般信息，记录请求日志（生产环境推荐）
# WARNING - 仅记录警告和错误
# ERROR   - 仅记录错误
# CRITICAL - 仅记录严重错误
LOG_LEVEL=DEBUG


# ========================================
# 数据库配置
# ========================================
# ThinkPython 支持以下配置方式：
# 
# 方式 1：DATABASE_URL 一行配置（推荐，与 SQLAlchemy/FastAPI 生态一致）
#   直接将完整连接 URL 填入 DATABASE_URL 环境变量即可
# 
# 方式 2：独立参数配置（兼容旧版本）
#   通过 DB_TYPE、DB_HOST、DB_PORT 等参数分别配置
# 
# 注意：DATABASE_URL 优先级高于独立参数配置

# --- 方式 1：DATABASE_URL 一行配置（推荐）---
# SQLite（开发/测试环境推荐）
# DATABASE_URL=sqlite+aiosqlite:///./data/database.db

# MySQL（生产环境推荐）
# DATABASE_URL=mysql+aiomysql://root:your_password@127.0.0.1:3306/thinkpython?charset=utf8mb4

# PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@127.0.0.1:5432/thinkpython

# SQL Server
# DATABASE_URL=mssql+aioodbc://sa:your_password@127.0.0.1:1433/thinkpython?driver=ODBC+Driver+17+for+SQL+Server

# --- 方式 2：独立参数配置 ---
# 当 DATABASE_URL 未设置时，使用以下独立参数构建连接 URL

# 是否启用数据库连接
DB_ENABLED=True

# 数据库类型选择
DB_TYPE=sqlite

# SQLite 配置（当 DB_TYPE=sqlite 时使用）
DB_SQLITE_PATH=./data/database.db

# MySQL / PostgreSQL / MSSQL 连接参数
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thinkpython
DB_USER=root
DB_PASSWORD=

# 连接池配置（仅对 MySQL/PostgreSQL/MSSQL 生效）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True
DB_CHARSET=utf8mb4
DB_ECHO=False


# ========================================
# 缓存配置
# ========================================
# ThinkPython 支持以下配置方式：
#
# 方式 1：REDIS_URL 一行配置（推荐，与 Redis 生态一致）
#   直接将完整连接 URL 填入 REDIS_URL 环境变量即可
#
# 方式 2：独立参数配置（兼容旧版本）
#   通过 REDIS_HOST、REDIS_PORT 等参数分别配置
#
# 注意：REDIS_URL 优先级高于独立参数配置

# 是否启用缓存
CACHE_ENABLED=True

# 缓存类型选择
CACHE_TYPE=memory

# 缓存键统一前缀
CACHE_PREFIX=thinkpython:

# 缓存默认过期时间（秒）
CACHE_DEFAULT_TTL=3600

# --- 方式 1：REDIS_URL 一行配置（推荐）---
# 无密码: REDIS_URL=redis://127.0.0.1:6379/0
# 有密码: REDIS_URL=redis://:your_password@127.0.0.1:6379/0
# REDIS_URL=redis://:your_password@127.0.0.1:6379/0

# --- 方式 2：独立参数配置 ---
# 当 REDIS_URL 未设置时，使用以下独立参数构建连接

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# --- Memory 内存缓存配置 ---
MEMORY_CACHE_MAX_SIZE=1000
MEMORY_CACHE_TTL=300

# --- Memcached 配置 ---
MEMCACHED_SERVERS=127.0.0.1:11211


# ========================================
# JWT 认证配置
# ========================================

# 是否启用全局认证中间件
# True  - 所有接口默认需要认证，除非在白名单中
# False - 所有接口默认公开，除非明确要求认证
AUTH_ENABLED=true

# JWT 签名密钥（生产环境务必使用强随机密钥，建议 32 位以上）
# 可使用命令生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-change-this-in-production

# JWT 签名算法（推荐保持 HS256）
JWT_ALGORITHM=HS256

# Access Token 过期时间（小时），用于日常接口访问
# 建议设置较短时间（1-2小时），提高安全性
JWT_ACCESS_TOKEN_EXPIRE_HOURS=2

# Refresh Token 过期时间（天），用于刷新 Access Token
# 建议设置较长时间（7-30天），减少用户登录频率
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh Token 是否可轮换（每次刷新生成新的 Refresh Token）
# True  - 开启轮换，更安全，旧的 Refresh Token 立即失效（推荐）
# False - 不开启轮换，Refresh Token 可重复使用
JWT_REFRESH_TOKEN_ROTATE=true

# 是否启用 Token 黑名单（需要 Redis 支持）
# True  - 用户登出时将 Token 加入黑名单，有效期内无法再次使用
# False - 不启用黑名单，Token 只能等待自然过期
TOKEN_BLACKLIST_ENABLED=false


# ========================================
# API 限流配置
# ========================================

# 是否启用 API 限流功能
# True  - 启用限流，所有请求将经过限流检查
# False - 关闭限流，所有请求直接放行
RATE_LIMIT_ENABLED=false

# 限流后端选择
# memory - 内存限流器，适用于单机环境（开发/测试）
# redis  - Redis 限流器，适用于分布式环境（生产）
RATE_LIMIT_BACKEND=memory

# --- 全局限流 ---
# 整个应用每分钟允许的最大请求数
RATE_LIMIT_GLOBAL_REQUESTS=1000
RATE_LIMIT_GLOBAL_PERIOD=60

# --- IP 限流 ---
# 单个 IP 每分钟允许的最大请求数
RATE_LIMIT_IP_REQUESTS=100
RATE_LIMIT_IP_PERIOD=60

# --- 登录接口限流 ---
# 防止暴力破解密码
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_PERIOD=60

# --- 注册接口限流 ---
# 防止恶意批量注册
RATE_LIMIT_REGISTER_REQUESTS=3
RATE_LIMIT_REGISTER_PERIOD=60

# --- 忘记密码接口限流 ---
# 防止短信/邮件轰炸
RATE_LIMIT_FORGOT_PASSWORD_REQUESTS=2
RATE_LIMIT_FORGOT_PASSWORD_PERIOD=60

# --- Redis 限流 Key 前缀 ---
RATE_LIMIT_REDIS_PREFIX=ratelimit:


# ========================================
# 文件上传配置
# ========================================

# 上传目录路径（相对于项目根目录）
UPLOAD_DIR=uploads

# 最大文件大小（字节），默认 10MB
# 10 * 1024 * 1024 = 10485760
UPLOAD_MAX_FILE_SIZE=10485760

# 文件命名规则
# uuid      - 使用 UUID 命名，完全避免冲突（推荐）
# timestamp - 使用时间戳 + 随机字符串
# original  - 保留原始文件名（可能冲突，不推荐）
UPLOAD_NAMING_RULE=uuid
