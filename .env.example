# ========================================
# ThinkPython 环境配置文件
# ========================================
# 使用说明：
#   1. 本文件包含所有可配置的环境变量，每项都附有详细说明
#   2. 复制本文件为 .env.local 或直接在 .env 中修改
#   3. 生产环境建议通过系统环境变量注入，而非使用 .env 文件
#   4. 修改配置后需要重启服务才能生效
# ========================================


# ========================================
# 应用基础配置
# ========================================

# 应用名称，会显示在 API 文档和健康检查接口中
APP_NAME=ThinkPython

# 应用版本号，建议遵循语义化版本规范 (主版本.次版本.修订号)
APP_VERSION=1.0.0

# 调试模式开关
# True  - 开发环境，启用详细错误信息、自动重载、API 文档页面
# False - 生产环境，隐藏敏感错误信息，提升性能
APP_DEBUG=True

# 应用时区，使用 IANA 时区标识符
# 常用值: Asia/Shanghai, America/New_York, Europe/London, UTC
TIMEZONE=Asia/Shanghai

# 应用默认语言，用于国际化响应消息
# 常用值: zh-CN (简体中文), en-US (英文), ja-JP (日文)
LANGUAGE=zh-CN


# ========================================
# 模块模式配置
# ========================================
# ThinkPython 支持两种项目组织模式：
# 单模块模式 - 所有代码放在 app/single/ 目录，适合小型项目和快速开发
# 多模块模式 - 代码按业务模块拆分（如 admin、api、order），适合中大型项目和团队协作

# 模块模式选择
# single - 单模块模式（默认推荐，新手友好）
# multi  - 多模块模式（适合项目规模扩大后切换）
MODULE_MODE=single

# 启用的模块列表（仅在 MODULE_MODE=multi 时生效）
# 自动发现模式（推荐）：设为 * 或留空，框架自动扫描 app/ 下所有模块，新增模块无需修改配置
# 白名单模式：指定具体模块名（逗号分隔），如 admin,api，只加载配置的模块
# 开发环境建议使用 *，生产环境建议指定具体模块名以便精确控制
ENABLED_MODULES=*

# 默认模块（仅在 MODULE_MODE=multi 时生效）
# 当访问路径不带模块前缀时，使用此模块处理请求
DEFAULT_MODULE=api

# 全局路由前缀（可选）
# 设置后所有接口都会加上此前缀，如设置为 /v1 则访问 /v1/user/list
# 留空表示不添加全局前缀
ROUTE_PREFIX=


# ========================================
# 跨域配置 (CORS)
# ========================================
# 跨域资源共享设置，用于允许前端域名访问 API
# 开发环境可设为 *，生产环境建议指定具体域名

# 允许跨域请求的来源域名，多个用逗号分隔
# *         - 允许所有域名（仅开发环境）
# http://localhost:3000 - 允许本地前端
# https://example.com   - 允许线上前端
CORS_ORIGINS=*


# ========================================
# 日志配置
# ========================================

# 日志记录级别，控制输出日志的详细程度
# DEBUG   - 最详细，包含所有调试信息（开发环境推荐）
# INFO    - 一般信息，记录请求日志（生产环境推荐）
# WARNING - 仅记录警告和错误
# ERROR   - 仅记录错误
# CRITICAL - 仅记录严重错误
LOG_LEVEL=DEBUG


# ========================================
# 数据库配置
# ========================================
# ThinkPython 支持以下数据库（通过 DB_TYPE 切换）：
#   sqlite      - 轻量级文件数据库，零配置，开发环境首选
#   mysql       - 最流行的关系型数据库，生产环境首选
#   postgresql  - 功能强大的开源数据库
#   mssql       - Microsoft SQL Server

# 是否启用数据库连接
# True  - 启用（需要数据库服务）
# False - 禁用（适用于纯缓存/无数据库场景）
DB_ENABLED=True

# 数据库类型选择（根据实际使用的数据库修改）
DB_TYPE=sqlite

# --- SQLite 配置（当 DB_TYPE=sqlite 时使用）---
# 数据库文件存放路径，相对于项目根目录
DB_SQLITE_PATH=./data/database.db

# --- MySQL / PostgreSQL / MSSQL 通用配置 ---
# 数据库服务器地址
DB_HOST=127.0.0.1

# 数据库服务端口
# MySQL:      3306
# PostgreSQL: 5432
# MSSQL:      1433
DB_PORT=3306

# 数据库名称（需要提前手动创建）
DB_NAME=thinkpython

# 数据库用户名
DB_USER=root

# 数据库密码（生产环境务必设置强密码）
DB_PASSWORD=

# --- 连接池配置（高并发场景建议调整）---
# 连接池基础大小，即保持的最小连接数
DB_POOL_SIZE=10

# 最大溢出连接数，超过 pool_size 后最多额外创建的连接数
DB_MAX_OVERFLOW=20

# 连接回收时间（秒），超过此时间的空闲连接会被回收
# 3600 = 1小时，MySQL 默认超时 28800 秒（8小时）
DB_POOL_RECYCLE=3600

# 使用连接前是否检测连接有效性（推荐开启，避免 "MySQL server has gone away"）
DB_POOL_PRE_PING=True

# 是否打印执行的 SQL 语句（开发调试时可开启）
# True  - 在控制台打印所有 SQL（开发环境推荐）
# False - 不打印 SQL（生产环境推荐）
DB_ECHO=False


# ========================================
# 缓存配置
# ========================================
# ThinkPython 支持以下缓存类型（通过 CACHE_TYPE 切换）：
#   memory    - 内存缓存，零配置，开发环境首选（进程重启后缓存丢失）
#   redis     - 高性能内存数据库，生产环境首选（支持持久化和分布式）
#   memcached - 分布式缓存系统（适合大规模缓存场景）

# 是否启用缓存
# True  - 启用
# False - 禁用
CACHE_ENABLED=True

# 缓存类型选择（根据实际使用的缓存服务修改）
CACHE_TYPE=memory

# 缓存键统一前缀，用于区分不同项目的缓存数据
# 例如前缀为 "thinkpython:" 时，实际缓存键为 "thinkpython:user:1"
CACHE_PREFIX=thinkpython:

# 缓存默认过期时间（秒），设置缓存时未指定过期时间则使用此值
# 300   = 5 分钟
# 3600  = 1 小时（默认推荐）
# 86400 = 24 小时
CACHE_DEFAULT_TTL=3600

# --- Redis 配置（当 CACHE_TYPE=redis 时使用）---
# Redis 服务器地址
REDIS_HOST=127.0.0.1

# Redis 服务端口（默认 6379）
REDIS_PORT=6379

# Redis 数据库编号（0-15，默认 0）
REDIS_DB=0

# Redis 密码（未设置密码时留空）
REDIS_PASSWORD=

# Redis 最大连接数（根据并发量调整）
REDIS_MAX_CONNECTIONS=20

# --- Memory 内存缓存配置（当 CACHE_TYPE=memory 时使用）---
# 最大缓存条目数，超过此数量时会淘汰最旧的缓存
MEMORY_CACHE_MAX_SIZE=1000

# 默认 TTL（秒），内存缓存条目的默认过期时间
MEMORY_CACHE_TTL=300

# --- Memcached 配置（当 CACHE_TYPE=memcached 时使用）---
# Memcached 服务器地址，多个用逗号分隔
MEMCACHED_SERVERS=127.0.0.1:11211
