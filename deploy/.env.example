# ThinkPython 生产环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ==============================
# 应用配置
# ==============================
APP_NAME=ThinkPython
APP_VERSION=1.0.0
APP_DEBUG=false
MODULE_MODE=single

# ==============================
# 数据库配置（MySQL）
# ==============================
DB_ENABLED=true
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=thinkpython
DB_USER=root
DB_PASSWORD=${DB_PASSWORD}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false

# ==============================
# 缓存配置（Redis）
# ==============================
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_PREFIX=thinkpython:
CACHE_DEFAULT_TTL=3600
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_MAX_CONNECTIONS=20

# ==============================
# JWT 认证配置
# ==============================
AUTH_ENABLED=true
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=2
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_ROTATE=true
TOKEN_BLACKLIST_ENABLED=true

# ==============================
# API 限流配置
# ==============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_GLOBAL_REQUESTS=1000
RATE_LIMIT_GLOBAL_PERIOD=60
RATE_LIMIT_IP_REQUESTS=100
RATE_LIMIT_IP_PERIOD=60
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_PERIOD=60
RATE_LIMIT_REGISTER_REQUESTS=3
RATE_LIMIT_REGISTER_PERIOD=60
RATE_LIMIT_FORGOT_PASSWORD_REQUESTS=2
RATE_LIMIT_FORGOT_PASSWORD_PERIOD=60
RATE_LIMIT_REDIS_PREFIX=ratelimit:

# ==============================
# 跨域配置
# ==============================
CORS_ORIGINS=https://your_domain.com

# ==============================
# 日志配置
# ==============================
LOG_LEVEL=INFO

# ==============================
# 文件上传配置
# ==============================
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_NAMING_RULE=uuid
