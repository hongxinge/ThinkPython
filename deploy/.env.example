# ThinkPython 生产环境变量模板（裸机 / 云主机部署）
#
# 使用方式：
#   cp deploy/.env.example .env && vim .env
#   gunicorn -c deploy/gunicorn.conf.py main:app
#
# 重要：
#   1. 本文件中的值都是**字面量**，python-dotenv 不会展开 ${VAR}，
#      写成 ${DB_PASSWORD} 会让密码变成这串字符本身。请直接填真实值。
#   2. 本文件是生产模板；仓库根的 .env.example 是本地开发模板，两者不要混用。
#   3. 本文件含密钥，已被 .gitignore 排除，不要提交。

# ==============================
# 应用
# ==============================
APP_NAME=ThinkPython
APP_VERSION=1.0.0
# 生产必须为 false：关闭 /docs、关闭详细堆栈、JWT 默认密钥将拒绝启动
APP_DEBUG=false
MODULE_MODE=multi
ENABLED_MODULES=admin,api
DEFAULT_MODULE=api
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
# 慢请求告警阈值（毫秒）
LOG_SLOW_REQUEST_MS=500
# 部署在 Nginx 之后必须设为 true，否则限流会把所有用户当成同一个 IP
TRUST_PROXY=true

# ==============================
# 响应压缩与契约
# ==============================
# JSON 接口压缩率通常 80% 左右，移动端建议保持开启
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESS_LEVEL=6
# 生产默认不暴露 /openapi.json。
# 需要生成客户端 SDK 时用命令行（不依赖该端点）：
#   python think.py make-client --lang ts --out client
OPENAPI_ENABLED=false

# ==============================
# 数据库（MySQL）
# ==============================
DB_ENABLED=true
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thinkpython
# 应用账号：由 deploy/mysql-init.sql 创建，不要用 root
DB_USER=thinkpython
DB_PASSWORD=请替换为强随机密码
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false

# ==============================
# 缓存（Redis）
# ==============================
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_PREFIX=thinkpython:
CACHE_DEFAULT_TTL=3600
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 留空表示不设密码（仅限完全隔离的内网）；生产建议设置
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# ==============================
# JWT 认证（必填）
# ==============================
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 留空或使用默认值时，APP_DEBUG=false 会直接拒绝启动
JWT_SECRET=请替换为64位随机十六进制字符串
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=2
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_ROTATE=true
AUTH_ENABLED=true
# 启用后登出可让 Token 立即失效（依赖 Redis）
TOKEN_BLACKLIST_ENABLED=true
# 改密/禁用后旧 Token 立即失效
TOKEN_VERSION_CHECK=true
TOKEN_VERSION_CACHE_TTL=60
# 登录失败锁定
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=30

# ==============================
# 错误响应契约
# ==============================
# standard：HTTP 状态码表达传输语义（推荐）
# legacy：所有业务错误一律 HTTP 200，靠 body.code 判断（兼容旧前端）
ERROR_HTTP_MODE=standard

# ==============================
# 限流
# ==============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_GLOBAL_REQUESTS=1000
RATE_LIMIT_GLOBAL_PERIOD=60
RATE_LIMIT_IP_REQUESTS=100
RATE_LIMIT_IP_PERIOD=60
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_PERIOD=60
RATE_LIMIT_REGISTER_REQUESTS=3
RATE_LIMIT_REGISTER_PERIOD=60
RATE_LIMIT_REDIS_PREFIX=ratelimit:

# ==============================
# 跨域（必填，逗号分隔）
# ==============================
# 不能为 *：与 allow_credentials 冲突。填写真实前端域名。
CORS_ORIGINS=https://your_domain.com

# ==============================
# 文件上传
# ==============================
# 上传目录：相对路径以项目根为基准；独立数据盘可写绝对路径（如 /data/uploads）
# 修改后 Nginx 的 location /uploads/ alias 必须指向同一目录
UPLOAD_DIR=uploads
# 对外 URL 前缀，由 Nginx 的 location /uploads/ 映射，与磁盘位置解耦
UPLOAD_URL_PREFIX=/uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_NAMING_RULE=uuid

# 分片上传（大文件/弱网）
UPLOAD_CHUNKED_ENABLED=true
UPLOAD_CHUNKED_PREFERRED_SIZE=2097152
UPLOAD_CHUNKED_MAX_CHUNK_SIZE=8388608
UPLOAD_CHUNKED_MAX_TOTAL_SIZE=2147483648
UPLOAD_CHUNKED_MAX_CHUNKS=10000
UPLOAD_CHUNKED_SESSION_TTL=86400

# ==============================
# Gunicorn
# ==============================
# 建议值：CPU 核数 × 2 + 1；按服务器实际内存与数据库连接上限调整
GUNICORN_WORKERS=4
# 绑定地址（Nginx 反代本机时建议 127.0.0.1:8000，不对外暴露）
GUNICORN_BIND=0.0.0.0:8000

# ==============================
# 权限与幂等
# ==============================
DEFAULT_ROLE=user
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL=86400
